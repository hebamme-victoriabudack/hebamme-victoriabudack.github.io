    "format": "prettier -w ./src",
    "remove-darkmode": "node scripts/removeDarkmode.js && yarn format"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@digi4care/astro-google-tagmanager": "^2.0.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/signika": "^5.3.0",
    "astro": "7.3.2",
    "astro-auto-import": "^0.6.0",
    "astro-swiper": "^2.10.0",
    "date-fns": "^4.1.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.12",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "remark-collapse": "^0.1.2",
