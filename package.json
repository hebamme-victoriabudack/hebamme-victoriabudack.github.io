    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "6.0.3"
