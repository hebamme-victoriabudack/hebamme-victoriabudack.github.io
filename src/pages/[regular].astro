---
export const prerender = true;

import Base from "@/layouts/Base.astro";
import HeroBanner from "@/partials/HeroBanner.astro";
import { render } from "astro:content";
import { getSinglePage, getSinglePageBySlug } from "@/lib/contentParser.astro";

// ✅ Tell Astro which routes exist at build time
export async function getStaticPaths() {
  const pages = await getSinglePage("pages");

  return pages.map((page) => ({
    params: {
      regular: page.id, // IMPORTANT: id is the slug
    },
  }));
}

const { regular } = Astro.params;
const page = await getSinglePageBySlug("pages", regular);

if (!page) {
  return Astro.redirect("/404");
}

const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);

const bannerData = { title, image };
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <!-- Banner -->
  <HeroBanner banner={bannerData} />
  <!-- /Banner -->

  <!-- Content -->
  <div class="container pt-8">
    <div class="row justify-center">
      <div class="md:col-10 lg:col-10">
        <div class="content">
          <Content />
        </div>
      </div>
    </div>
  </div>
  <!-- /Content -->
</Base>
