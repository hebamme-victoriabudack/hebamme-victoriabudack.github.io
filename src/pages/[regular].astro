---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import HeroBanner from "@/partials/HeroBanner.astro";
import { render } from "astro:content";

// get static paths for all pages
export async function getStaticPaths() {
  const COLLECTION_FOLDER = "pages";

  const pages = await getSinglePage(COLLECTION_FOLDER);

  const paths = pages.map((page) => ({
    params: {
      regular: page.id,
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;
const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);

const bannerData = {
  title,
  image,
};

// legal boilerplate pages aren't real "services" - skip Service/Breadcrumb schema for them
const LEGAL_PAGES = ["impressum", "datenschutz"];
const pageUrl = `${config.site.base_url}/${page.id}/`;

const jsonLd = LEGAL_PAGES.includes(page.id)
  ? undefined
  : [
      {
        "@context": "https://schema.org",
        "@type": "Service",
        serviceType: title,
        name: title,
        description,
        url: pageUrl,
        provider: { "@id": `${config.site.base_url}/#business` },
        areaServed: { "@type": "City", name: "Dresden" },
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Startseite",
            item: `${config.site.base_url}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: title,
            item: pageUrl,
          },
        ],
      },
    ];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  jsonLd={jsonLd}
  noindex={LEGAL_PAGES.includes(page.id)}
>
  <!-- Banner -->
  <HeroBanner banner={bannerData} />
  <!-- /Banner -->

  <!-- Content -->
  <div class="container pt-8">
    <div class="row justify-center">
      <div class="md:col-10 lg:col-10">
        <div class="content">
          <Content />
        </div>
      </div>
    </div>
  </div>
  <!-- /Content -->
</Base>
