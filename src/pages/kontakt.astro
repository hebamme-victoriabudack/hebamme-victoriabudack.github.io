---
// import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import HeroBanner from "@/partials/HeroBanner.astro";

const contactIndex = await getListPage("contact", "-index");

const { title, description, meta_title, image, contact_details } =
  contactIndex.data;

if (contactIndex.data.draft) {
  return Astro.redirect("/404");
}

const bannerData = {
  title: title,
  image: image,
  contact_details: contact_details,
};

// Optional: Add form state (success/error) from query params
// const success = Astro.request.query.get("success") === "true";
// const error = Astro.request.query.get("error");
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <HeroBanner banner={bannerData} />

  <section class="section-sm">
    <div class="container">
      <div class="mx-auto md:col-10 lg:col-6">
        <!-- Contact Form -->
        <form
          action="/contact"
          method="POST"
          class="space-y-6"
          onSubmit={(e) => {
            // Prevent double submit
            const button = e.currentTarget.querySelector(
              "button[type='submit']",
            );
            button.disabled = true;
            button.textContent = "Senden...";
          }}
        >
          <div class="mb-6">
            <label
              for="name"
              class="block text-sm font-medium text-gray-700 mb-1"
            >
              Name <span class="text-red-500">*</span>
            </label>
            <input
              id="name"
              name="name"
              class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
              type="text"
              required
              aria-required="true"
            />
          </div>

          <div class="mb-6">
            <label
              for="email"
              class="block text-sm font-medium text-gray-700 mb-1"
            >
              E-Mail <span class="text-red-500">*</span>
            </label>
            <input
              id="email"
              name="email"
              class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
              type="email"
              required
              aria-required="true"
            />
          </div>

          <div class="mb-6">
            <label
              for="message"
              class="block text-sm font-medium text-gray-700 mb-1"
            >
              Deine Nachricht <span class="text-red-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
              required
              aria-required="true"
              rows="8"></textarea>
          </div>

          <button
            type="submit"
            class="px-6 py-3 bg-blue-600 text-white font-medium rounded-md shadow hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition"
          >
            Senden
          </button>
        </form>
      </div>
    </div>
  </section>
</Base>
