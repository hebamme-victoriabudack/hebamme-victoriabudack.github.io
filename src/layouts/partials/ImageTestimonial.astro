---
import ImageMod from "@/components/ImageMod.astro";
import * as testimonials from "../../content/sections/image-testimonial.md";

import {
  Swiper,
  SwiperPagination,
  SwiperSlide,
  SwiperWrapper,
} from "astro-swiper";
import type { SwiperOptions } from "swiper/types";

const swiperOptions: SwiperOptions = {
  spaceBetween: 24,
  loop: true,
  autoplay: {
    delay: 2500,
    disableOnInteraction: false,
  },
  pagination: {
    el: ".testimonial-slider-pagination",
    type: "bullets",
    clickable: true,
  },
  breakpoints: {
    0: { slidesPerView: 2 },
    512: { slidesPerView: 3 },
    992: { slidesPerView: 4 },
  },
};
---

{
  testimonials.frontmatter.enable && (
    <Swiper options={swiperOptions} class="testimonial-slider">
      <SwiperWrapper class="mb-12">
        {testimonials.frontmatter.testimonials.map(
          (item: { image: string; alt: string }) => (
            <SwiperSlide>
              <div class="w-full aspect-square rounded-lg overflow-hidden">
                <ImageMod
                  src={item.image}
                  alt={item.alt}
                  class="w-full h-full object-contain"
                  loading="lazy"
                  decoding="async"
                  sizes="(min-width: 992px) 25vw, 33vw"
                  widths={[160, 320, 480, 640, 768]}
                />
              </div>
            </SwiperSlide>
          ),
        )}
      </SwiperWrapper>
      <SwiperPagination class="testimonial-slider-pagination flex items-center justify-center" />
    </Swiper>
  )
}
