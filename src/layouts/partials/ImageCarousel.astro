---
import ImageMod from "@/components/ImageMod.astro";
import * as imageCarousel from "../../content/sections/image-carousel.md";

import {
  Swiper,
  SwiperPagination,
  SwiperSlide,
  SwiperWrapper,
} from "astro-swiper";
import type { AstroSwiperOptions } from "astro-swiper";

const swiperOptions: AstroSwiperOptions = {
  spaceBetween: 24,
  loop: true,
  autoplay: {
    delay: 2500,
    disableOnInteraction: false,
  },
  pagination: {
    el: ".image-carousel-pagination",
    type: "bullets",
    clickable: true,
  },
  breakpoints: {
    0: { slidesPerView: 2 },
    512: { slidesPerView: 3 },
    992: { slidesPerView: 4 },
  },
  astro: {
    intersectionObserver: {
      // defer Swiper init until the carousel scrolls into view instead of
      // running its init/autoplay/pagination JS during initial page load
      initSwiper: true,
      disconnectOnInit: true,
    },
  },
};
---

{imageCarousel.frontmatter.enable && (
  <Swiper options={swiperOptions} class="image-carousel-slider">
    <SwiperWrapper class="mb-12">
      {imageCarousel.frontmatter.images.map(
        (item: { image: string; alt: string }) => (
          <SwiperSlide>
            <div class="w-full aspect-square rounded-lg overflow-hidden">
              <ImageMod
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-contain"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 992px) 25vw, 33vw"
                widths={[160, 320, 480, 640, 768]}
              />
            </div>
          </SwiperSlide>
        ),
      )}
    </SwiperWrapper>
    <SwiperPagination class="image-carousel-pagination flex items-center justify-center" />
  </Swiper>
)}
