---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "@fontsource/heebo/400.css";
import "@fontsource/heebo/600.css";
import "@fontsource/signika/500.css";
import "@fontsource/signika/700.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { ClientRouter } from "astro:transitions";

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  jsonLd?: Record<string, unknown>[];
}

// destructure frontmatter
const { title, meta_title, description, image, noindex, canonical, jsonLd } =
  Astro.props;

// self-referencing canonical unless a page explicitly overrides it
const resolvedCanonical =
  canonical ?? new URL(Astro.url.pathname, config.site.base_url).toString();

// resolve the OG/Twitter preview image through Astro's image pipeline (same
// glob ImageMod.astro uses) instead of linking the pre-build /images/* path,
// which never exists in the deployed output — Sharp hashes it to /_astro/*
const rawImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,avif}",
);
const ogImageSourcePath = image ?? config.metadata.meta_image;
const ogImageModule = await rawImages[`/src/assets${ogImageSourcePath}`]?.();
const ogImageUrl = ogImageModule
  ? `${config.site.base_url}${
      (await getImage({ src: ogImageModule.default, width: 1200 })).src
    }`
  : `${config.site.base_url}${ogImageSourcePath}`;

// sitewide entity graph: the practice, the practitioner, and the site itself
const business = config.business;
const businessId = `${config.site.base_url}/#business`;
const practitionerId = `${config.site.base_url}/#practitioner`;
const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": businessId,
      name: `${business.name} – ${business.jobTitle}`,
      description: config.metadata.meta_description,
      url: `${config.site.base_url}/`,
      image: `${config.site.base_url}${config.metadata.meta_image}`,
      telephone: business.telephone,
      email: business.email,
      identifier: {
        "@type": "PropertyValue",
        name: "IK-Nummer",
        value: business.identifier,
      },
      address: {
        "@type": "PostalAddress",
        ...business.address,
      },
      areaServed: business.areaServed,
      medicalSpecialty: "https://schema.org/Midwifery",
      founder: { "@id": practitionerId },
    },
    {
      "@type": "Person",
      "@id": practitionerId,
      name: business.name,
      jobTitle: business.jobTitle,
      description: config.metadata.meta_description,
      url: `${config.site.base_url}/`,
      image: `${config.site.base_url}${config.metadata.meta_image}`,
      telephone: business.telephone,
      email: business.email,
      worksFor: { "@id": businessId },
      affiliation: {
        "@type": "MedicalBusiness",
        name: business.affiliation.name,
        url: business.affiliation.url,
        address: {
          "@type": "PostalAddress",
          ...business.address,
        },
      },
    },
    {
      "@type": "WebSite",
      "@id": `${config.site.base_url}/#website`,
      url: `${config.site.base_url}/`,
      name: config.site.title,
      inLanguage: "de-DE",
      publisher: { "@id": businessId },
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <!-- google tag manager -->
    {config.google_tag_manager.enable && (
      <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
    )}
    <!-- favicon -->
    <link rel="icon" type="image/png" href={config.site.favicon} />
    <link rel="apple-touch-icon" href={config.site.favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- theme meta -->
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={resolvedCanonical} item-prop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- structured data: practitioner + website (sitewide) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph)} />

    <!-- structured data: page-specific (Service, BreadcrumbList, ...) -->
    {jsonLd &&
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
      ))}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta property="og:image" content={ogImageUrl} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {/* google tag manager noscript */}
    {config.google_tag_manager.enable && (
      <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
    )}

    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
