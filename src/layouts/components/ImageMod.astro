---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string; // e.g. "/images/foo.jpg"
  alt: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  format?: "auto" | "avif" | "jpeg" | "png" | "webp";
  class?: string;
  style?: any;
  transition_name?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  transition_name,
} = Astro.props;

// Import from src/assets
const images = import.meta.glob(
  "/src/assets/images/**/*.{jpeg,jpg,png,gif,svg,webp}",
  { eager: true },
);

const image = images[`/src/assets${src}`]?.default as ImageMetadata | undefined;

if (!image) {
  console.error(`\x1b[31mImage not found: ${src}\x1b[0m`);
}
---

{
  image && (
    <Image
      src={image}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding={decoding}
      class={className}
      format={format}
      style={style}
      transition:name={transition_name}
    />
  )
}
