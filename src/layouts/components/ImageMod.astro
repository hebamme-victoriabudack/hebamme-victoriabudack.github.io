---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { ImageOutputFormat } from "astro";

interface Props {
  src: string;
  alt: string;
  class?: string;
  style?: any;

  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";

  sizes?: string;
  widths?: number[];
  width?: number;
  height?: number;
  format?: ImageOutputFormat;
  priority?: boolean;
}

const {
  src,
  alt,
  class: className,
  style,
  loading = "lazy",
  decoding = "async",
  sizes = "100vw",
  widths,
  width,
  height,
  format,
  priority = false,
} = Astro.props;

/**
 * Glob ALL raster images under src/assets/images
 * Keys look like:
 *   /src/assets/images/foo.webp
 */
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,avif}",
);

const resolvedPath = `/src/assets${src}`;
const image = images[resolvedPath]?.();

if (!image) {
  console.error(
    `\x1b[31m[ImageMod] Image not found\x1b[0m\n` +
      `  src prop:      ${src}\n` +
      `  expected key:  ${resolvedPath}`,
  );
}
---

{image && (
  <Image
    src={image}
    alt={alt}
    class={className}
    style={style}
    sizes={sizes}
    widths={widths}
    width={width}
    height={height}
    format={format}
    loading={priority ? "eager" : loading}
    decoding={decoding}
    priority={priority}
  />
)}
